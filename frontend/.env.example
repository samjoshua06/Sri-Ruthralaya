# Sri Ruthralaya Frontend Environment Variables
# In production on Netlify or Vercel, point this to your Render backend service URL:
# VITE_API_BASE_URL=https://YOUR-RENDER-BACKEND-URL/api/v1
VITE_API_BASE_URL=
VITE_APP_NAME="Sri Ruthralaya Bharathanatyam Academy"
VITE_ACADEMY_PHONE="+91 98421 23456"
VITE_ACADEMY_LOCATION="Thiruthangal near Sivakasi, Tamil Nadu"
# Razorpay public Key ID only (KEY_SECRET stays on the backend)
VITE_RAZORPAY_KEY_ID=
