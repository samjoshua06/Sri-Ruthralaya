# Server Configuration
PORT=5000
NODE_ENV=production

# Database (Neon PostgreSQL connection string)
DATABASE_URL=

# JWT Authentication Secrets (Must be defined in production)
JWT_SECRET=
JWT_REFRESH_SECRET=

# AI Chatbot & Insights API Keys (Google Gemini [Recommended], OpenAI, or Claude - optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cloud Media Storage (Cloudinary - optional)
CLOUDINARY_URL=

# Allowed CORS Origins (Comma-separated for multiple)
FRONTEND_URL=

# Email Service (Nodemailer - for Password Recovery & Verification)
# Option A: Gmail (Recommended for quick setup)
# Generate a 16-character App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=your-academy-email@gmail.com
EMAIL_PASS=your-16-char-app-password

# Option B: Custom SMTP (Brevo, SendGrid, Mailgun, Amazon SES, or Hostinger/cPanel)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Sri Ruthralaya Academy" <info@sriruthralaya.com>
